{
    "name": "meits/entry-point-php",
    "description": "Hand-rolled minimal MVC entry point (router, ActiveRecord-style model, view) built from scratch on top of PHP-DI.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Viktor Gavrilenko",
            "email": "meitslin@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "php-di/php-di": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/var-dumper": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000 -t public"
    }
}
